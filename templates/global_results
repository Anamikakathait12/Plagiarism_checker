<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Global Database Scan - PlagiarismGuard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;
            background-attachment: fixed !important;
            min-height: 100vh;
            color: #f8fafc;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        .navbar-glass {
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .dashboard-card {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 2.5rem;
            color: #1e293b;
        }
        .table-container { border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05); }
        .table-dark th { background-color: #334155; color: #f8fafc; font-weight: 600; letter-spacing: 0.5px; border-bottom: none; padding: 1rem; }
        .table td { padding: 1rem; vertical-align: middle; }
        
        /* Cool pulsing animation for high risk alerts */
        .pulse-danger {
            animation: pulse-red 2s infinite;
            border-radius: 5px;
        }
        @keyframes pulse-red {
            0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
            70% { box-shadow: 0 0 0 8px rgba(220, 53, 69, 0); }
            100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg py-3 mb-5 navbar-glass">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand fw-bold fs-4 text-white text-decoration-none" href="/">
                <i class="bi bi-shield-check text-info"></i> PlagiarismGuard Core
            </a>
            <div class="d-flex align-items-center">
                <a class="btn btn-outline-light btn-sm rounded-pill px-4 fw-bold shadow-sm" href="{{ url_for('teacher.teacher_portal') }}"><i class="bi bi-arrow-left me-2"></i>Back to Portal</a>
            </div>
        </div>
    </nav>

    <div class="container mb-5">
        <div class="text-center mb-5">
            <h1 class="fw-bold text-white mb-2" style="font-size: 2.5rem; letter-spacing: -1px;">
                <i class="bi bi-globe2 text-info me-2"></i>Global Network Scan
            </h1>
            <p class="text-info fs-5">Deep Database Fingerprint Intersection Analysis</p>
        </div>

        <div class="dashboard-card mx-auto" style="max-width: 1100px;">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4 flex-wrap gap-3">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-cpu text-primary fs-3"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold">Winnowing Engine Results</h4>
                        <p class="text-muted small mb-0">Querying the entire historical database for structural cross-course matches.</p>
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge bg-dark fs-6 p-2 border border-secondary">Target Document ID: <span class="text-info font-monospace fs-5 ms-2">#{{ target_id }}</span></span>
                </div>
            </div>

            {% if matches %}
            <div class="alert alert-warning border-warning border-opacity-50 shadow-sm mb-4">
                <i class="fas fa-exclamation-circle me-2"></i><strong>Alert:</strong> The algorithm detected shared <i>K</i>-gram fingerprints between this document and historical submissions from multiple courses.
            </div>

            <div class="table-responsive table-container">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Matching Student</th>
                            <th scope="col">Subject / Course</th>
                            <th scope="col">Document Name</th>
                            <th scope="col">Mathematical Overlap</th>
                            <th scope="col">Severity Level</th>
                            <th scope="col" class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        {% for match in matches %}
                        <tr>
                            <td class="fw-bold text-primary">@{{ match['match_student'] }}</td>
                            
                            <td><span class="badge bg-secondary px-2 py-1 fs-6">{{ match['match_course'] }}</span></td>
                            
                            <td class="text-dark small fw-medium text-truncate" style="max-width: 220px;">
                                <i class="bi bi-file-earmark-text text-danger me-1"></i> {{ match['match_filename'] }}
                            </td>
                            
                            <td>
                                <span class="badge bg-dark text-white p-2" style="font-family: monospace;">
                                    <i class="bi bi-hash text-info"></i> {{ match['shared_count'] }} Hashes
                                </span>
                            </td>
                            
                            <td>
                                {% if match['shared_count'] > 30 %}
                                <div class="d-inline-block pulse-danger p-1">
                                    <span class="text-danger fw-bold"><i class="fas fa-exclamation-triangle me-1"></i> HIGH</span>
                                </div>
                                {% elif match['shared_count'] > 15 %}
                                <span class="text-warning fw-bold" style="color: #d97706 !important;"><i class="fas fa-exclamation-circle me-1"></i> MEDIUM</span>
                                {% else %}
                                <span class="text-info fw-bold"><i class="fas fa-info-circle me-1"></i> LOW</span>
                                {% endif %}
                            </td>
                            
                            <td class="text-center">
                                <a href="{{ url_for('analysis.inspect_global', target_id=target_id, match_id=match['matched_doc_id']) }}" target="_blank" class="btn btn-primary btn-sm fw-bold">
                                    <i class="bi bi-layout-split me-1"></i> Inspect
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="alert alert-success d-flex align-items-center p-4 shadow-sm border-success border-opacity-25" role="alert">
                <i class="fas fa-check-circle fs-1 text-success me-4"></i>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">Database Cleared!</h5>
                    <p class="mb-0 text-dark">No significant structural matches were found anywhere in the global course database database. The mathematical fingerprints appear unique.</p>
                </div>
            </div>
            {% endif %}

            <div class="text-center mt-5">
                <a href="{{ url_for('teacher.teacher_portal') }}" class="btn btn-secondary px-5 py-2 fw-bold shadow-sm"><i class="bi bi-arrow-left-circle me-2"></i>Return to Dashboard</a>
            </div>
        </div>
    </div>
</body>
</html>
